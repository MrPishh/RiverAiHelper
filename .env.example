# Copy this file to .env and fill in all values before running the bot.
# Never commit .env — it is excluded by .gitignore.

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=                        # Bot token from Discord Developer Portal

# Channel IDs (right-click channel → Copy Channel ID, needs Developer Mode on)
ANNOUNCEMENTS_CHANNEL_ID=             # #announcements channel — messages saved to KB
TWEETS_CHANNEL_ID=                    # #tweets channel — messages saved to KB
GENERAL_CHANNEL_ID=                   # #general channel
SUPPORT_CHANNEL_ID=                   # #support channel
STAFF_EXPLANATION_CHANNEL_ID=         # Staff-only channel for bot explanation embeds
REPORTS_CHANNEL_ID=                   # Channel where /report posts weekly/daily reports
BOT_ANSWER_CHANNEL_IDS=               # Comma-separated: channels where bot auto-answers unprompted

# Category IDs (right-click category → Copy Category ID)
# Channels inside these categories are logged but the bot never responds in them.
SUPPORT_TICKET_CATEGORY_IDS=          # Comma-separated support ticket category IDs → intent/ticket-log.jsonl
COLLAB_CATEGORY_IDS=                  # Comma-separated collab/business inquiry category IDs → intent/collab-log.jsonl

# Scam Blocker — bot deletes messages and issues 1-hour timeouts on detected scammers.
# Requires bot role to have Manage Messages + Moderate Members, and to sit above member roles.
# Toggle ON/OFF in Discord with: /toggle platform:scam-blocker  (default: OFF)
SCAM_LOG_CHANNEL_ID=                  # Channel where scam-blocker posts alert embeds (e.g. #auto-mod)

# Chinese community channels (optional — leave blank to exclude from reports)
CHINESE_DISCORD_CHANNEL_ID=           # Discord channel — logged for reports, bot never responds
CHINESE_TELEGRAM_TOPIC_ID=            # Telegram topic thread ID — logged for reports, bot never responds

# Role IDs (Server Settings → Roles → right-click → Copy Role ID)
STAFF_ROLE_IDS=                       # Comma-separated staff role IDs

# ── Claude / Anthropic ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                    # From console.anthropic.com

# ── Voyage AI (embeddings) ────────────────────────────────────────────────────
VOYAGE_API_KEY=                       # From dash.voyageai.com
EMBEDDING_PROVIDER=voyage             # Leave as "voyage"

# ── Telegram (optional — leave blank to disable Telegram bot) ─────────────────
TELEGRAM_BOT_TOKEN=                   # From @BotFather on Telegram
TELEGRAM_CHAT_ID=                     # Group chat ID (negative number for supergroups)
TELEGRAM_TOPIC_IDS=                   # Comma-separated topic/thread IDs bot should respond in

# ── Behaviour ─────────────────────────────────────────────────────────────────
STAFF_WAIT_MINUTES=5                  # Minutes bot waits for staff to reply before auto-answering
